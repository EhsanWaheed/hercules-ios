+/* "DKTR" v1: u32 source count, per source {u16 x,y,w,h; u8 kind, used;
+ * w*h u16 words}, u32 upload count, per upload {u32 source; u16 x,y,w,h;
+ * u32 splits}. Little-endian. */
+constexpr uint32_t kTrackingMagic = 0x52544B44u, kTrackingVersion = 1u;
+int duck_texture_pack_tracking_state_save(const DuckTexturePack* p, uint8_t** data, size_t* size) {
+    if (data) *data = nullptr;
+    if (size) *size = 0;
+    if (!p || !data || !size) return 0;
+    try {
+        std::vector<const Source*> order;
+        std::unordered_map<const Source*, uint32_t> index;
+        for (const auto& upload : p->uploads)
+            if (index.emplace(upload.source.get(), uint32_t(order.size())).second) order.push_back(upload.source.get());
+        std::vector<uint8_t> out;
+        const auto u8 = [&](unsigned v) { out.push_back(uint8_t(v)); };
+        const auto u16 = [&](unsigned v) { u8(v & 0xFF); u8((v >> 8) & 0xFF); };
+        const auto u32 = [&](uint32_t v) { u16(v & 0xFFFF); u16(v >> 16); };
+        const auto rect = [&](const Rect& r) { u16(r.x); u16(r.y); u16(r.w); u16(r.h); };
+        u32(kTrackingMagic); u32(kTrackingVersion); u32(uint32_t(order.size()));
+        for (const Source* s : order) {
+            rect(s->rect); u8(s->kind); u8(s->used);
+            for (uint16_t w : s->words) u16(w);
+        }
+        u32(uint32_t(p->uploads.size()));
+        for (const auto& upload : p->uploads) { u32(index[upload.source.get()]); rect(upload.active); u32(upload.splits); }
+        uint8_t* buffer = static_cast<uint8_t*>(std::malloc(out.size()));
+        if (!buffer) return 0;
+        std::memcpy(buffer, out.data(), out.size());
+        *data = buffer; *size = out.size();
+        return 1;
+    } catch (...) { return 0; }
+}
+int duck_texture_pack_tracking_state_load(DuckTexturePack* p, const uint8_t* data, size_t size) {
+    if (!p || !data) return 0;
+    try {
+        size_t at = 0;
+        bool ok = true;
+        const auto u8 = [&]() -> unsigned { if (at + 1 > size) { ok = false; return 0; } return data[at++]; };
+        const auto u16 = [&]() -> unsigned { const unsigned lo = u8(); return lo | (u8() << 8); };
+        const auto u32 = [&]() -> uint32_t { const uint32_t lo = u16(); return lo | (uint32_t(u16()) << 16); };
+        const auto rect = [&]() { Rect r; r.x = u16(); r.y = u16(); r.w = u16(); r.h = u16(); return r; };
+        if (u32() != kTrackingMagic || u32() != kTrackingVersion) return 0;
+        const uint32_t source_count = u32();
+        if (!ok || source_count > kMaxUploads) return 0;
+        std::deque<std::shared_ptr<Source>> sources;
+        size_t bytes = 0;
+        for (uint32_t i = 0; i < source_count; ++i) {
+            auto s = std::make_shared<Source>();
+            s->rect = rect(); s->kind = uint8_t(u8()); s->used = u8() != 0; s->dump_owner = p;
+            const size_t words = size_t(s->rect.w) * s->rect.h;
+            if (!ok || !valid_rect(s->rect) || s->kind != DUCK_TEXTURE_UPLOAD || at + 2 * words > size) return 0;
+            s->words.resize(words);
+            for (auto& w : s->words) w = uint16_t(u16());
+            s->hash = duck_texture_hash_words_le(s->words.data(), s->words.size());
+            bytes += words * sizeof(uint16_t);
+            sources.push_back(std::move(s));
+        }
+        const uint32_t upload_count = u32();
+        if (!ok || upload_count > kMaxUploads || bytes > p->snapshot_budget) return 0;
+        std::vector<Upload> uploads;
+        uploads.reserve(upload_count);
+        for (uint32_t i = 0; i < upload_count; ++i) {
+            const uint32_t source = u32(); const Rect active = rect(); const unsigned splits = u32();
+            if (!ok || source >= sources.size() || !valid_rect(active) || !contains(sources[source]->rect, active)) return 0;
+            uploads.push_back({sources[source], active, splits});
+        }
+        if (at != size || duck_texture_pack_flush_dumps(p, nullptr, 0) < 0) return 0;
+        p->uploads.swap(uploads); p->pages.clear(); p->sources.swap(sources);
+        p->snapshot_bytes = bytes; p->palette_records = 0;
+        p->copy_updates.clear(); p->copy_pending = false;
+        p->rect_cache.clear(); p->match_cache.clear(); ++p->revision;
+        return 1;
+    } catch (...) { return 0; }
+}
+int duck_texture_pack_explain(DuckTexturePack* p, const HdTextureDrawQuery* q, char* out, size_t cap) {
+    if (!out || !cap) return 0;
+    out[0] = '\0';
+    if (!p || !q) return 0;
+    Rect wanted{};
+    if (!query_rect(q, wanted)) { std::snprintf(out, cap, "page not supported by the pack"); return 1; }
+    try {
+        const unsigned ppw = expansion(q->depth);
+        int n = 0;
+        unsigned uploads = 0;
+        for (const auto& upload : p->uploads) {
+            if (!intersects(upload.active, wanted)) continue;
+            ++uploads;
+            const Rect s = upload.source->rect;
+            const auto found = p->uploads_by_hash[q->depth].find(upload.source->hash);
+            unsigned names = 0, sized = 0, placed = 0, palette = 0;
+            if (found != p->uploads_by_hash[q->depth].end()) for (const size_t index : found->second) {
+                ++names;
+                const auto& k = p->entries[index].key;
+                if (s.w != k.source_width_words || s.h != k.source_height) continue;
+                ++sized;
+                const Rect rect{s.x+k.offset_x/ppw, s.y+k.offset_y, unsigned(k.width)/ppw, k.height};
+                if (!intersects(rect, wanted)) continue;
+                ++placed;
+                bool valid = false;
+                if (palette_hash(*q, k.palette_min, k.palette_max, valid) == k.palette_hash && valid) ++palette;
+            }
+            if (n < 0 || size_t(n) >= cap) break;
+            n += std::snprintf(out + n, cap - n, "%supload %ux%u@%u,%u %016llX: %u names, %u size, %u here, %u palette",
+                               uploads > 1 ? "\n" : "", s.w, s.h, s.x, s.y,
+                               (unsigned long long)upload.source->hash, names, sized, placed, palette);
+            if (uploads >= 3) break;
+        }
+        if (!uploads) std::snprintf(out, cap, "no tracked upload under this texture");
+        return 1;
+    } catch (...) { return 0; }
+}
+int duck_texture_pack_tracking_summary(const DuckTexturePack* p, char* out, size_t cap) {
+    if (!out || !cap) return 0;
+    out[0] = '\0';
+    if (!p) return 0;
+    try {
+        std::vector<const Upload*> big;
+        for (const auto& upload : p->uploads)
+            if (size_t(upload.source->rect.w) * upload.source->rect.h >= kBigUpload) big.push_back(&upload);
+        std::sort(big.begin(), big.end(), [](const Upload* a, const Upload* b) {
+            return size_t(a->active.w) * a->active.h > size_t(b->active.w) * b->active.h;
+        });
+        int n = std::snprintf(out, cap, "tracked %zu uploads, %zu KB", p->uploads.size(), p->snapshot_bytes / 1024);
+        for (size_t i = 0; i < big.size() && i < 4 && n >= 0 && size_t(n) < cap; ++i) {
+            const Rect s = big[i]->source->rect, a = big[i]->active;
+            n += std::snprintf(out + n, cap - n, "\n  %ux%u@%u,%u", s.w, s.h, s.x, s.y);
+            if (a.x != s.x || a.y != s.y || a.w != s.w || a.h != s.h)
+                n += std::snprintf(out + n, cap - n, " part %ux%u@%u,%u split %u", a.w, a.h, a.x, a.y, big[i]->splits);
+        }
+        if (p->big_drops && n >= 0 && size_t(n) < cap)
+            std::snprintf(out + n, cap - n, "\nlost %llu big: %ux%u@%u,%u by write %ux%u@%u,%u",
+                          (unsigned long long)p->big_drops, p->last_big_drop.w, p->last_big_drop.h,
+                          p->last_big_drop.x, p->last_big_drop.y, p->last_big_drop_by.w,
+                          p->last_big_drop_by.h, p->last_big_drop_by.x, p->last_big_drop_by.y);
+        return 1;
+    } catch (...) { return 0; }
+}
 int duck_texture_pack_track_upload(DuckTexturePack* p, uint16_t x, uint16_t y, uint16_t w, uint16_t h,
                                   const uint16_t* vram, size_t count) {
     if (!p) return 0;
