diff --git a/runtime/src/psx_debug_overlay.c b/runtime/src/psx_debug_overlay.c
new file mode 100644
index 0000000..2aadcd8
--- /dev/null
+++ b/runtime/src/psx_debug_overlay.c
@@ -0,0 +1,538 @@
+/* psx_debug_overlay.c — F3 statistics and F4 object inspector.
+ *
+ * The emulation thread records the textured draws of each guest frame while
+ * the inspector is on, picks the topmost one under the mouse and builds the
+ * panel image. HD texture questions are answered on the thread that matches
+ * draws (the GL render thread when it runs): it takes the pending request at
+ * the next present, so the pack is never touched from two threads. */
+#include "psx_debug_overlay.h"
+#include "gpu_hd_textures.h"
+#include "host_osd.h"
+#include "psx_sdl.h"
+
+#include <stdio.h>
+#include <string.h>
+#if defined(__linux__)
+#include <time.h>
+#include <dirent.h>
+#endif
+
+#define MAX_DRAWS     8192
+#define PANEL_COLS    80
+#define PANEL_LINES   30
+#define GLYPH         8
+#define LINE_H        10
+#define PAD           4
+#define REFRESH_MS    500
+
+typedef struct {
+    int16_t x[4], y[4];
+    uint8_t n, semi;
+    int16_t limits[4];
+    uint16_t clut_x, clut_y, texpage;
+    uint32_t window;
+} Draw;
+
+static int s_stats, s_inspect, s_frozen;
+static int s_mouse_x = -1, s_mouse_y = -1;
+static int s_direct, s_direct_x, s_direct_y;   /* debug server without a window */
+
+/* Draws of the frame being built and of the last finished one. */
+static Draw s_draws[2][MAX_DRAWS];
+static int s_count[2], s_cur;
+static uint64_t s_frame_draws;
+
+/* Selected draw (in the finished frame) and its answer. */
+static int s_sel_valid, s_ptr_valid, s_ptr_x, s_ptr_y;
+static Draw s_sel;
+
+static SDL_mutex *s_lock;
+static struct {
+    int disp_x, disp_y, disp_w, disp_h, lx, ly, lw, lh, ww, wh, valid;
+} s_geo;
+static struct {
+    unsigned request, answered;
+    Draw draw;
+} s_ask;
+/* Recent answers by texture, so a selection that alternates between a few
+ * textures (two buffered frames, animation) keeps showing them. */
+#define ANSWERS 8
+static struct { int valid; Draw key; char text[512]; } s_answers[ANSWERS];
+static int s_answer_next;
+static char s_tracking[640];
+static uint64_t s_presents, s_services;
+static double s_render_cpu_pct;
+
+/* Panel */
+static uint32_t s_img[(PANEL_LINES * LINE_H + 2 * PAD) * (PANEL_COLS * GLYPH + 2 * PAD)];
+static int s_img_w, s_img_h, s_img_valid;
+static char s_lines[PANEL_LINES][PANEL_COLS + 1];
+static int s_nlines;
+
+/* Statistics window */
+static uint64_t s_win_start, s_last_frame;
+static uint64_t s_win_frames, s_win_max_ns, s_win_draws, s_win_presents;
+static double s_emu_cpu0, s_proc_cpu0;
+static GpuHdTextureDiag s_diag0;
+static char s_stat_lines[12][PANEL_COLS + 1];
+static int s_nstat;
+
+static int contains(const Draw *d, int px, int py);
+static void bbox(const Draw *d, int *x0, int *y0, int *x1, int *y1);
+
+static void lock(void) {
+    if (!s_lock) s_lock = SDL_CreateMutex();
+    if (s_lock) SDL_LockMutex(s_lock);
+}
+static void unlock(void) { if (s_lock) SDL_UnlockMutex(s_lock); }
+
+static uint64_t now_ns(void) {
+    const uint64_t f = SDL_GetPerformanceFrequency();
+    const uint64_t c = SDL_GetPerformanceCounter();
+    return f ? (uint64_t)((double)c * 1e9 / (double)f) : 0;
+}
+
+#if defined(__linux__)
+static double cpu_seconds(clockid_t id) {
+    struct timespec t;
+    if (clock_gettime(id, &t) != 0) return 0.0;
+    return (double)t.tv_sec + (double)t.tv_nsec * 1e-9;
+}
+static int read_int_file(const char *path, long *out) {
+    FILE *f = fopen(path, "r");
+    if (!f) return 0;
+    const int ok = fscanf(f, "%ld", out) == 1;
+    fclose(f);
+    return ok;
+}
+static long rss_mb(void) {
+    long pages = 0, resident = 0;
+    FILE *f = fopen("/proc/self/statm", "r");
+    if (!f) return -1;
+    const int ok = fscanf(f, "%ld %ld", &pages, &resident) == 2;
+    fclose(f);
+    return ok ? resident * 4096 / (1024 * 1024) : -1;
+}
+/* First DRM device that reports a busy percentage (amdgpu does). */
+static long gpu_busy_pct(void) {
+    static char path[96];
+    static int searched;
+    long v = -1;
+    if (!searched) {
+        searched = 1;
+        for (int i = 0; i < 8 && !path[0]; i++) {
+            char p[96];
+            snprintf(p, sizeof p, "/sys/class/drm/card%d/device/gpu_busy_percent", i);
+            if (read_int_file(p, &v)) snprintf(path, sizeof path, "%s", p);
+        }
+    }
+    if (!path[0] || !read_int_file(path, &v)) return -1;
+    return v;
+}
+#endif
+
+void psx_dbgov_toggle_stats(void) {
+    s_stats = !s_stats;
+    s_win_start = 0;
+    s_nstat = 0;
+    host_osd_push(s_stats ? "Debug stats on (F3)" : "Debug stats off", 1200);
+}
+void psx_dbgov_toggle_inspect(void) {
+    s_inspect = !s_inspect;
+    s_frozen = 0;
+    s_sel_valid = 0;
+    s_count[0] = s_count[1] = 0;
+    host_osd_push(s_inspect ? "Inspector on (F4): mouse over an object, click to freeze"
+                            : "Inspector off", 2000);
+}
+int psx_dbgov_inspect_active(void) { return s_inspect; }
+void psx_dbgov_mouse_motion(int x, int y) { s_mouse_x = x; s_mouse_y = y; s_direct = 0; }
+void psx_dbgov_mouse_click(void) { if (s_inspect) s_frozen = !s_frozen; }
+
+void psx_dbgov_set_modes(int stats, int inspect, int frozen) {
+    if (stats >= 0 && (stats != 0) != (s_stats != 0)) psx_dbgov_toggle_stats();
+    if (inspect >= 0 && (inspect != 0) != (s_inspect != 0)) psx_dbgov_toggle_inspect();
+    if (frozen >= 0 && s_inspect) s_frozen = frozen != 0;
+}
+void psx_dbgov_point_guest(int gx, int gy) {
+    lock();
+    s_direct = !s_geo.valid;
+    s_direct_x = gx; s_direct_y = gy;
+    if (s_geo.valid) {
+        const int top = s_geo.wh - s_geo.ly - s_geo.lh;
+        s_mouse_x = s_geo.lx + (2 * gx + 1) * s_geo.lw / (2 * s_geo.disp_w);
+        s_mouse_y = top + (2 * gy + 1) * s_geo.lh / (2 * s_geo.disp_h);
+    }
+    unlock();
+}
+int psx_dbgov_panel_text(char *out, int cap) {
+    int n = 0;
+    if (!out || cap <= 0) return 0;
+    out[0] = '\0';
+    for (int i = 0; i < s_nlines && n < cap; i++)
+        n += snprintf(out + n, (size_t)(cap - n), "%s%s", i ? "\n" : "", s_lines[i]);
+    return n;
+}
+
+int psx_dbgov_draws_near(int gx, int gy, char *out, int cap) {
+    int n = 0;
+    const int done = s_cur ^ 1;
+    if (!out || cap <= 0) return 0;
+    out[0] = '\0';
+    for (int i = 0; i < s_count[done] && n < cap - 96; i++) {
+        int x0, y0, x1, y1;
+        bbox(&s_draws[done][i], &x0, &y0, &x1, &y1);
+        if (gx < x0 - 4 || gx > x1 + 4 || gy < y0 - 4 || gy > y1 + 4) continue;
+        const Draw *d = &s_draws[done][i];
+        n += snprintf(out + n, (size_t)(cap - n), "#%d n%d bbox %d,%d-%d,%d in %d tp %04X\n", i, d->n,
+                      x0, y0, x1, y1, contains(d, gx, gy), d->texpage);
+    }
+    return n;
+}
+
+int psx_dbgov_wants_draws(void) { return s_stats || (s_inspect && !s_frozen); }
+
+void psx_dbgov_note_draw(const int *xs, const int *ys, int vertices, const int limits[4],
+                         uint16_t clut_x, uint16_t clut_y, uint16_t texpage,
+                         uint32_t texture_window, int semitransparent) {
+    s_frame_draws++;
+    if (!s_inspect || s_frozen || s_count[s_cur] >= MAX_DRAWS) return;
+    Draw *d = &s_draws[s_cur][s_count[s_cur]++];
+    d->n = (uint8_t)(vertices > 4 ? 4 : vertices);
+    for (int i = 0; i < d->n; i++) { d->x[i] = (int16_t)xs[i]; d->y[i] = (int16_t)ys[i]; }
+    for (int i = 0; i < 4; i++) d->limits[i] = (int16_t)limits[i];
+    d->clut_x = clut_x; d->clut_y = clut_y; d->texpage = texpage;
+    d->window = texture_window; d->semi = (uint8_t)(semitransparent != 0);
+}
+
+/* Same texture question: page, palette, sampled texels, window, blending. */
+static int same_texture(const Draw *a, const Draw *b) {
+    return a->texpage == b->texpage && a->clut_x == b->clut_x && a->clut_y == b->clut_y &&
+           a->window == b->window && a->semi == b->semi &&
+           !memcmp(a->limits, b->limits, sizeof a->limits);
+}
+
+static int edge(int ax, int ay, int bx, int by, int px, int py) {
+    return (bx - ax) * (py - ay) - (by - ay) * (px - ax);
+}
+static int contains(const Draw *d, int px, int py) {
+    if (d->n == 2) {    /* rectangle: corners */
+        return px >= d->x[0] && px < d->x[1] && py >= d->y[0] && py < d->y[1];
+    }
+    const int e0 = edge(d->x[0], d->y[0], d->x[1], d->y[1], px, py);
+    const int e1 = edge(d->x[1], d->y[1], d->x[2], d->y[2], px, py);
+    const int e2 = edge(d->x[2], d->y[2], d->x[0], d->y[0], px, py);
+    return (e0 >= 0 && e1 >= 0 && e2 >= 0) || (e0 <= 0 && e1 <= 0 && e2 <= 0);
+}
+static void bbox(const Draw *d, int *x0, int *y0, int *x1, int *y1) {
+    *x0 = *x1 = d->x[0]; *y0 = *y1 = d->y[0];
+    for (int i = 1; i < d->n; i++) {
+        if (d->x[i] < *x0) *x0 = d->x[i];
+        if (d->x[i] > *x1) *x1 = d->x[i];
+        if (d->y[i] < *y0) *y0 = d->y[i];
+        if (d->y[i] > *y1) *y1 = d->y[i];
+    }
+}
+
+/* Mouse (drawable pixels) to display-relative guest pixels. */
+static int mouse_to_guest(int *gx, int *gy) {
+    int ok = 0;
+    if (s_direct) { *gx = s_direct_x; *gy = s_direct_y; return 1; }
+    lock();
+    if (s_geo.valid && s_geo.lw > 0 && s_geo.lh > 0 && s_mouse_x >= 0) {
+        const int top = s_geo.wh - s_geo.ly - s_geo.lh;  /* GL viewport is bottom-left */
+        const int mx = s_mouse_x - s_geo.lx, my = s_mouse_y - top;
+        if (mx >= 0 && my >= 0 && mx < s_geo.lw && my < s_geo.lh) {
+            *gx = mx * s_geo.disp_w / s_geo.lw;
+            *gy = my * s_geo.disp_h / s_geo.lh;
+            ok = 1;
+        }
+    }
+    unlock();
+    return ok;
+}
+
+/* Caller holds the lock. */
+static const char *answer_for(const Draw *d) {
+    for (int k = 1; k <= ANSWERS; k++) {
+        const int i = (s_answer_next - k + ANSWERS) % ANSWERS;
+        if (s_answers[i].valid && same_texture(&s_answers[i].key, d)) return s_answers[i].text;
+    }
+    return NULL;
+}
+
+static void select_draw(void) {
+    int gx, gy;
+    const int done = s_cur ^ 1;
+    if (s_frozen) return;
+    s_ptr_valid = mouse_to_guest(&gx, &gy);
+    s_ptr_x = gx; s_ptr_y = gy;
+    if (!s_ptr_valid) { s_sel_valid = 0; return; }
+    s_sel_valid = 0;
+    for (int i = s_count[done] - 1; i >= 0; i--)
+        if (contains(&s_draws[done][i], gx, gy)) { s_sel = s_draws[done][i]; s_sel_valid = 1; break; }
+    if (!s_sel_valid) return;
+    lock();
+    if (!same_texture(&s_ask.draw, &s_sel) && !answer_for(&s_sel)) {
+        s_ask.draw = s_sel;
+        s_ask.request++;
+    }
+    unlock();
+}
+
+static void add_line(const char *fmt, const char *text) {
+    /* Split on newlines; long lines are cut at the panel width. */
+    char buf[1024];
+    snprintf(buf, sizeof buf, fmt, text);
+    char *p = buf;
+    while (p && s_nlines < PANEL_LINES) {
+        char *nl = strchr(p, '\n');
+        if (nl) *nl = '\0';
+        /* Wrap long lines (file paths); continuation lines are indented. */
+        size_t len = strlen(p), at = 0;
+        do {
+            const int indent = at ? 2 : 0;
+            const size_t take = len - at < (size_t)(PANEL_COLS - indent) ? len - at : (size_t)(PANEL_COLS - indent);
+            snprintf(s_lines[s_nlines++], PANEL_COLS + 1, "%*s%.*s", indent, "", (int)take, p + at);
+            at += take;
+        } while (at < len && s_nlines < PANEL_LINES);
+        p = nl ? nl + 1 : NULL;
+    }
+}
+
+static void update_stats(void) {
+    const uint64_t t = now_ns();
+    if (!s_win_start) {
+        s_win_start = t;
+        s_win_frames = s_win_max_ns = s_win_draws = 0;
+        lock(); s_win_presents = s_presents; unlock();
+#if defined(__linux__)
+        s_emu_cpu0 = cpu_seconds(CLOCK_THREAD_CPUTIME_ID);
+        s_proc_cpu0 = cpu_seconds(CLOCK_PROCESS_CPUTIME_ID);
+#endif
+        gpu_hd_textures_get_diag(&s_diag0);
+        return;
+    }
+    if (t - s_win_start < (uint64_t)REFRESH_MS * 1000000u || !s_win_frames) return;
+    const double secs = (double)(t - s_win_start) * 1e-9;
+    uint64_t presents;
+    double render_pct;
+    char tracking[640];
+    lock();
+    presents = s_presents - s_win_presents;
+    s_win_presents = s_presents;
+    render_pct = s_render_cpu_pct;
+    snprintf(tracking, sizeof tracking, "%s", s_tracking);
+    unlock();
+    GpuHdTextureDiag d;
+    gpu_hd_textures_get_diag(&d);
+    const double frames = (double)s_win_frames;
+    const uint64_t q = d.draw_queries - s_diag0.draw_queries;
+    const uint64_t m = d.matched_draws - s_diag0.matched_draws;
+    const uint64_t a = d.applied_draws - s_diag0.applied_draws;
+    s_nstat = 0;
+    snprintf(s_stat_lines[s_nstat++], PANEL_COLS + 1, "Game %.1f fps  frame %.1f ms (max %.1f)  Display %.1f fps",
+             frames / secs, secs * 1000.0 / frames, (double)s_win_max_ns * 1e-6, (double)presents / secs);
+#if defined(__linux__)
+    const double emu = cpu_seconds(CLOCK_THREAD_CPUTIME_ID), proc = cpu_seconds(CLOCK_PROCESS_CPUTIME_ID);
+    const long gpu = gpu_busy_pct(), ram = rss_mb();
+    snprintf(s_stat_lines[s_nstat++], PANEL_COLS + 1, "CPU emu %.0f%%  render %.0f%%  process %.0f%% of a core",
+             100.0 * (emu - s_emu_cpu0) / secs, render_pct, 100.0 * (proc - s_proc_cpu0) / secs);
+    char gpu_text[16];
+    if (gpu >= 0) snprintf(gpu_text, sizeof gpu_text, "%ld%%", gpu);
+    else snprintf(gpu_text, sizeof gpu_text, "n/a");
+    snprintf(s_stat_lines[s_nstat++], PANEL_COLS + 1, "GPU busy %s  RAM %ld MB", gpu_text, ram);
+    s_emu_cpu0 = emu; s_proc_cpu0 = proc;
+#else
+    (void)render_pct;
+    snprintf(s_stat_lines[s_nstat++], PANEL_COLS + 1, "CPU/GPU/RAM: Linux only");
+#endif
+    snprintf(s_stat_lines[s_nstat++], PANEL_COLS + 1, "Draws %.0f/frame  HD queries %.0f  matched %.0f%%  applied %.0f",
+             (double)s_win_draws / frames, (double)q / frames, q ? 100.0 * (double)m / (double)q : 0.0,
+             (double)a / frames);
+    char *p = tracking;
+    while (p && *p && s_nstat < 12) {
+        char *nl = strchr(p, '\n');
+        if (nl) *nl = '\0';
+        snprintf(s_stat_lines[s_nstat++], PANEL_COLS + 1, "%s", p);
+        p = nl ? nl + 1 : NULL;
+    }
+    s_diag0 = d;
+    s_win_start = t;
+    s_win_frames = s_win_max_ns = s_win_draws = 0;
+}
+
+static void describe_draw(const Draw *d, char *out, size_t cap) {
+    int x0, y0, x1, y1;
+    bbox(d, &x0, &y0, &x1, &y1);
+    const unsigned tp = d->texpage;
+    const int depth = (int)((tp >> 7) & 3u);
+    const int page_x = (int)(tp & 0xFu) * 64, page_y = (int)((tp >> 4) & 1u) * 256;
+    static const char *const bits[] = { "4-bit", "8-bit", "15-bit", "?" };
+    snprintf(out, cap,
+             "%s at %d,%d size %dx%d%s\n"
+             "page %d,%d %s  clut %u,%u\n"
+             "uv %d..%d, %d..%d",
+             d->n == 2 ? "Sprite" : "Triangle", x0, y0, x1 - x0, y1 - y0,
+             d->semi ? "  semi-transparent" : "",
+             page_x, page_y, bits[depth], d->clut_x, d->clut_y,
+             d->limits[0], d->limits[2], d->limits[1], d->limits[3]);
+}
+
+static void build_panel(void) {
+    s_nlines = 0;
+    if (s_stats) {
+        for (int i = 0; i < s_nstat; i++) add_line("%s", s_stat_lines[i]);
+        if (!s_nstat) add_line("%s", "measuring...");
+    }
+    if (s_inspect) {
+        if (s_stats) add_line("%s", "");
+        char head[96];
+        if (s_ptr_valid)
+            snprintf(head, sizeof head, "Inspector at %d,%d, %d draws%s", s_ptr_x, s_ptr_y, s_count[s_cur ^ 1],
+                     s_frozen ? " (frozen, click)" : " (click to freeze)");
+        else
+            snprintf(head, sizeof head, "Inspector: pointer outside the picture");
+        add_line("%s", head);
+        if (!s_sel_valid) add_line("%s", "no textured object under the mouse");
+        else {
+            char text[256], answer[512];
+            describe_draw(&s_sel, text, sizeof text);
+            add_line("%s", text);
+            lock();
+            const char *known = answer_for(&s_sel);
+            snprintf(answer, sizeof answer, "%s", known ? known : "asking the texture pack...");
+            unlock();
+            add_line("%s", answer);
+        }
+    }
+    int cols = 0;
+    for (int i = 0; i < s_nlines; i++) {
+        const int len = (int)strlen(s_lines[i]);
+        if (len > cols) cols = len;
+    }
+    if (!s_nlines) { s_img_valid = 0; return; }
+    s_img_w = cols * GLYPH + 2 * PAD;
+    s_img_h = s_nlines * LINE_H + 2 * PAD;
+    for (int i = 0; i < s_img_w * s_img_h; i++) s_img[i] = 0xFF101418u;
+    for (int l = 0; l < s_nlines; l++) {
+        const int hd = !strncmp(s_lines[l], "HD ", 3), sd = !strncmp(s_lines[l], "SD ", 3);
+        const uint32_t ink = hd ? 0xFF60FF60u : sd ? 0xFFFF7060u : 0xFFE8E8E8u;
+        for (int c = 0; s_lines[l][c]; c++) {
+            const uint8_t *g = host_osd_glyph((unsigned char)s_lines[l][c]);
+            for (int row = 0; row < GLYPH; row++)
+                for (int col = 0; col < GLYPH; col++)
+                    if (g[row] & (1u << col))
+                        s_img[(PAD + l * LINE_H + row) * s_img_w + PAD + c * GLYPH + col] = ink;
+        }
+    }
+    s_img_valid = 1;
+}
+
+void psx_dbgov_frame_end(void) {
+    if (!s_stats && !s_inspect) { s_img_valid = 0; s_frame_draws = 0; return; }
+    const uint64_t t = now_ns();
+    if (s_last_frame && t - s_last_frame > s_win_max_ns) s_win_max_ns = t - s_last_frame;
+    s_last_frame = t;
+    s_win_frames++;
+    s_win_draws += s_frame_draws;
+    s_frame_draws = 0;
+    /* The game does not draw a new picture every vblank: keep the last
+     * picture until the next one has draws. */
+    if (s_inspect && !s_frozen && s_count[s_cur] > 0) {
+        s_cur ^= 1;
+        s_count[s_cur] = 0;
+    }
+    if (s_inspect) select_draw();
+    if (s_stats) update_stats();
+    build_panel();
+}
+
+void psx_dbgov_set_present_geometry(int disp_x, int disp_y, int disp_w, int disp_h,
+                                    int lx, int ly, int lw, int lh, int ww, int wh) {
+    if (!s_stats && !s_inspect) return;
+    lock();
+    s_geo.disp_x = disp_x; s_geo.disp_y = disp_y; s_geo.disp_w = disp_w; s_geo.disp_h = disp_h;
+    s_geo.lx = lx; s_geo.ly = ly; s_geo.lw = lw; s_geo.lh = lh; s_geo.ww = ww; s_geo.wh = wh;
+    s_geo.valid = disp_w > 0 && disp_h > 0;
+    unlock();
+}
+
+void psx_dbgov_render_tick(void) {
+    if (!s_stats && !s_inspect) return;
+    lock();
+    s_presents++;
+    unlock();
+    psx_dbgov_service();
+}
+
+void psx_dbgov_service(void) {
+    static uint64_t last_summary, cpu_t0;
+    static double cpu0;
+    if (!s_stats && !s_inspect) return;
+    lock();
+    s_services++;
+    const int pending = s_ask.request != s_ask.answered;
+    Draw d = s_ask.draw;
+    const unsigned request = s_ask.request;
+    unlock();
+    if (pending) {
+        char text[512];
+        const int limits[4] = { d.limits[0], d.limits[1], d.limits[2], d.limits[3] };
+        if (!gpu_hd_textures_describe(d.texpage, d.clut_x, d.clut_y, limits, d.window, d.semi,
+                                      text, sizeof text) || !text[0])
+            snprintf(text, sizeof text, "HD textures inactive");
+        lock();
+        s_answers[s_answer_next].valid = 1;
+        s_answers[s_answer_next].key = d;
+        snprintf(s_answers[s_answer_next].text, sizeof s_answers[0].text, "%s", text);
+        s_answer_next = (s_answer_next + 1) % ANSWERS;
+        s_ask.answered = request;
+        unlock();
+    }
+    const uint64_t t = now_ns();
+    if (t - last_summary >= (uint64_t)REFRESH_MS * 1000000u) {
+        char text[640];
+        if (!gpu_hd_textures_tracking_summary(text, sizeof text)) snprintf(text, sizeof text, "HD textures inactive");
+#if defined(__linux__)
+        const double c = cpu_seconds(CLOCK_THREAD_CPUTIME_ID);
+        const double pct = cpu_t0 ? 100.0 * (c - cpu0) / ((double)(t - cpu_t0) * 1e-9) : 0.0;
+        cpu0 = c; cpu_t0 = t;
+#else
+        const double pct = 0.0;
+#endif
+        lock();
+        snprintf(s_tracking, sizeof s_tracking, "%s", text);
+        s_render_cpu_pct = pct;
+        unlock();
+        last_summary = t;
+    }
+}
+
+int psx_dbgov_needs_present(void) { return s_img_valid; }
+
+int psx_dbgov_overlay_image(const uint32_t **pixels, int *w, int *h) {
+    if (!s_img_valid) { *pixels = NULL; *w = *h = 0; return 0; }
+    *pixels = s_img; *w = s_img_w; *h = s_img_h;
+    return 1;
+}
+
+int psx_dbgov_highlight(int *x, int *y, int *w, int *h, uint32_t *argb) {
+    if (!s_inspect || !s_sel_valid) return 0;
+    int x0, y0, x1, y1, ok = 0;
+    bbox(&s_sel, &x0, &y0, &x1, &y1);
+    lock();
+    if (s_geo.valid) {
+        const int top = s_geo.wh - s_geo.ly - s_geo.lh;
+        *x = s_geo.lx + x0 * s_geo.lw / s_geo.disp_w;
+        *y = top + y0 * s_geo.lh / s_geo.disp_h;
+        *w = (x1 - x0) * s_geo.lw / s_geo.disp_w;
+        *h = (y1 - y0) * s_geo.lh / s_geo.disp_h;
+        ok = *w > 0 && *h > 0;
+    }
+    const char *known = answer_for(&s_sel);
+    const int hd = known && !strncmp(known, "HD ", 3);
+    unlock();
+    *argb = hd ? 0xFF40FF40u : 0xFFFF4040u;
+    return ok;
+}
