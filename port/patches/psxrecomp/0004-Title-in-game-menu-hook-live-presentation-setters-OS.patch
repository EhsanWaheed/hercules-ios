From 097d03a6986d16aff2f0adc6301ed022fef40d06 Mon Sep 17 00:00:00 2001
From: obaidr1 <147771377+obaidr1@users.noreply.github.com>
Date: Tue, 13 Oct 2026 18:31:20 +0200
Subject: [PATCH] Title in-game menu hook, live presentation setters, OSD
 without recomp-ui

psx_game_menu.h: a title registers its own menu; Esc or Select+Start opens
it, the guest freezes as for the save-state menu, keys go to the menu and its
image is composited over the held frame (overlay slot of the save-state
menu). Start stays away from the guest while Select is held. psx_host_*
change scanlines, CRT, colour model, texture filter, 16:9/4:3, fullscreen,
volume, HD pack, perspective and geometry live. PSX_VOLUME sets the start
volume; PSX_HOST_OSD_VISUAL shows the host toasts without recomp-ui.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 runtime/include/psx_game_menu.h |  53 ++++++++++++
 runtime/src/gpu_gl_renderer.c   |   4 +-
 runtime/src/host_osd.c          |   3 +-
 runtime/src/main.cpp            | 144 ++++++++++++++++++++++++++++++++
 4 files changed, 202 insertions(+), 2 deletions(-)
 create mode 100644 runtime/include/psx_game_menu.h

diff --git a/runtime/include/psx_game_menu.h b/runtime/include/psx_game_menu.h
new file mode 100644
index 0000000..25d8aec
--- /dev/null
+++ b/runtime/include/psx_game_menu.h
@@ -0,0 +1,53 @@
+#pragma once
+/* A title's own in-game menu (options, help), drawn and run by the game.
+ *
+ * The title registers hooks (usually from a static constructor). The host
+ * opens it on Esc or Select+Start, freezes the guest like the save-state
+ * menu, sends keys to it and composites its image over the held frame, full
+ * window, until it closes. While Select is held, Start stays away from the
+ * guest so the chord does not also open the game's own pause screen.
+ *
+ * psx_host_* change presentation settings live (no restart) for such a menu.
+ */
+#include <stdint.h>
+
+#ifdef __cplusplus
+extern "C" {
+#endif
+
+typedef struct PsxGameMenuHooks {
+    void (*open)(void);
+    int  (*is_open)(void);
+    /* SDL keycode / scancode / modifiers of a key press while open */
+    void (*key)(int keycode, int scancode, int mod, int repeat);
+    /* once per host loop while open (pad navigation, animation) */
+    void (*tick)(uint32_t now_ms);
+    /* 0xAARRGGBB image stretched over the whole window; 0 = nothing */
+    int  (*image)(const uint32_t **pixels, int *w, int *h);
+} PsxGameMenuHooks;
+
+void psx_game_menu_register(const PsxGameMenuHooks *hooks);
+
+/* host side, for the menu */
+int      psx_game_menu_overlay_image(const uint32_t **pixels, int *w, int *h);
+void     psx_host_window_size(int *w, int *h);         /* drawable pixels */
+uint32_t psx_host_p1_buttons(void);                     /* SDL gamepad button mask, P1 */
+void     psx_host_osd(const char *message, int ms);
+void     psx_host_quit(void);                            /* leave the game */
+
+void psx_host_set_scanlines(int on, float strength);
+void psx_host_set_crt(int on, float mask, float bloom);
+void psx_host_set_screen_kind(int kind);                 /* 0 raw 1 crt 2 composite 3 trinitron */
+void psx_host_set_texture_filter(int mode);              /* 0 nearest 1 bilinear 3 xbr */
+int  psx_host_set_display_aspect(int num, int den);      /* 16:9 native-wide or 4:3 */
+void psx_host_set_fullscreen(int mode);                  /* 0 window 1 borderless 2 exclusive */
+int  psx_host_get_fullscreen(void);
+void psx_host_set_volume(int percent);
+int  psx_host_get_volume(void);
+int  psx_host_set_hd_pack(const char *root);             /* NULL/"" = off */
+void psx_host_set_perspective(int on);
+void psx_host_set_geometry(int on);
+
+#ifdef __cplusplus
+}
+#endif
