 #include "psx_debug_overlay.h"
 #include "host_time.h"
 #include "latency_ring.h"
@@ -9262,7 +9263,8 @@ static int ov_image(int i, const uint32_t **px, int *w, int *h) {
     case 0: return host_osd_image(px, w, h);
     case 1: return host_osd_volume_image(px, w, h);
     case 2: return psx_rewind_overlay_image(px, w, h);
-    case 3: return psx_savestate_menu_overlay_image(px, w, h);
+    case 3: return psx_game_menu_overlay_image(px, w, h) ||
