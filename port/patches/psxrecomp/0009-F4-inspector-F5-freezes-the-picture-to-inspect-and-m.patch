+static void describe_draw(const Draw *d, char *out, size_t cap);
+static void write_marks(void) {
+    FILE *f = fopen("texture_marks.txt", "w");
+    if (!f) { snprintf(s_marks_note, sizeof s_marks_note, "could not write texture_marks.txt"); return; }
+    fprintf(f, "# objects marked in the F4 inspector (F5 = frozen picture, click = mark)\n");
+    for (int i = 0; i < s_nmarks; i++) {
+        char desc[256];
+        describe_draw(&s_marks[i].d, desc, sizeof desc);
+        fprintf(f, "\n[%d] %s\n%s\n", i + 1, desc, s_marks[i].has_text ? s_marks[i].text : "(asking the texture pack...)");
+    }
+    fclose(f);
+    snprintf(s_marks_note, sizeof s_marks_note, "%d marked, saved to texture_marks.txt", s_nmarks);
+}
+/* Caller holds no lock. */
+static void mark_toggle(void) {
+    if (!s_sel_valid) return;
+    for (int i = 0; i < s_nmarks; i++)
+        if (same_texture(&s_marks[i].d, &s_sel) && !memcmp(s_marks[i].d.x, s_sel.x, sizeof s_sel.x) &&
+            !memcmp(s_marks[i].d.y, s_sel.y, sizeof s_sel.y)) {
+            memmove(&s_marks[i], &s_marks[i + 1], sizeof s_marks[0] * (size_t)(s_nmarks - i - 1));
+            s_nmarks--;
+            write_marks();
+            host_osd_push("Unmarked", 1000);
+            return;
+        }
+    if (s_nmarks >= MAX_MARKS) { host_osd_push("At most 64 marks", 1500); return; }
+    s_marks[s_nmarks].d = s_sel;
+    lock();
+    const char *known = answer_for(&s_sel);
+    s_marks[s_nmarks].has_text = known != NULL;
+    snprintf(s_marks[s_nmarks].text, sizeof s_marks[0].text, "%s", known ? known : "");
+    unlock();
+    s_nmarks++;
+    write_marks();
+    host_osd_push("Marked", 1000);
+}
