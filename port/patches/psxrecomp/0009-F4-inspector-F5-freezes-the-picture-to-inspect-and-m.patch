+/* Inspector freeze (F5 with F4 on): the guest stops on its last picture; the
+ * mouse keeps picking objects, wheel/Tab/PageUp/PageDown step through what is
+ * stacked under it, a click marks one, F5 or Esc goes on, F4 ends it all. */
+static bool debug_overlay_mouse_event(const SDL_Event& ev);
+static void dbgov_host_pause_loop(void) {
+    psx_local_mouse_reset();
+    freeze_heartbeat_set_paused(1);
+    while (psx_dbgov_paused()) {
+#ifndef PSX_NO_DEBUG_TOOLS
+        debug_server_poll();     /* scripted checks drive it through debug_overlay */
+#endif
+        SDL_Event ev;
+        while (SDL_PollEvent(&ev)) {
+            if (debug_overlay_mouse_event(ev)) continue;
+            if (ev.type == SDL_QUIT) {
+                psx_crash_trace_set_exit_origin("sdl_window_close");
+                shutdown_runtime();
+                std::exit(0);
+            } else if (ev.type == SDL_KEYDOWN) {
+#if defined(PSX_SDL3)
+                const SDL_Keycode key = ev.key.key;
+                const SDL_Keymod mod = ev.key.mod;
+                const int repeat = ev.key.repeat ? 1 : 0;
+#else
+                const SDL_Keycode key = ev.key.keysym.sym;
+                const Uint16 mod = ev.key.keysym.mod;
+                const int repeat = ev.key.repeat ? 1 : 0;
+#endif
+                if ((key == SDLK_F5 || key == SDLK_ESCAPE) && !repeat) psx_dbgov_toggle_pause();
+                else if (key == SDLK_F4 && !repeat) psx_dbgov_toggle_inspect();
+                else if (key == SDLK_TAB) psx_dbgov_cycle((mod & KMOD_SHIFT) ? -1 : 1);
+                else if (key == SDLK_PAGEDOWN) psx_dbgov_cycle(1);
+                else if (key == SDLK_PAGEUP) psx_dbgov_cycle(-1);
+                else if ((key == SDLK_RETURN || key == SDLK_SPACE) && !repeat) psx_dbgov_mouse_click();
+            }
+        }
+        psx_dbgov_paused_tick();
+        rewind_pause_present();
+        starvation_watchdog_heartbeat();
+        SDL_Delay(8);
+    }
+    freeze_heartbeat_set_paused(0);
+    savestate_input_guard_arm();   /* the key that ended it must not reach the game */
+}
