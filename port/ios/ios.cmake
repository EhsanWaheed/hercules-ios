# iOS / iPadOS app: the psx-runtime target as an .app bundle. Included from
# hercules_game.cmake when CMAKE_SYSTEM_NAME is iOS. Everything is compiled
# ahead of time (game, overlays, SDL3): no JIT, so the app runs sideloaded
# (LiveContainer, SideStore) as well as from Xcode.
#
#   cmake -S versions/SCES-00891 -B build-ios -G Ninja -DCMAKE_SYSTEM_NAME=iOS \
#         -DCMAKE_OSX_SYSROOT=iphoneos -DCMAKE_OSX_ARCHITECTURES=arm64 \
#         -DCMAKE_OSX_DEPLOYMENT_TARGET=17.0 -DPSX_ENABLE_VULKAN=OFF
#
# HERC_IOS_BUNDLE_DISC: a folder holding the player's .cue/.bin, copied into
# the app as game/ (the owner's own IPA). Empty for the public "no game
# files" IPA, whose launcher imports the disc on first start.

set(HERC_IOS_DIR "${HERC_ROOT}/ios")
set(HERC_IOS_BUNDLE_ID "com.E5N97.hercules" CACHE STRING "iOS bundle identifier")
set(HERC_IOS_APP_VERSION "0.1" CACHE STRING "CFBundleShortVersionString")
set(HERC_IOS_BUNDLE_DISC "" CACHE PATH "Folder with the disc (.cue + .bin) to put in the app; empty: none")

# ---- the framework's OpenGL renderer on iOS ------------------------------
# gpu_gl_renderer.c loads modern GL through function pointers and calls a few
# GL 1.x entry points directly. iOS has no desktop GL, so the renderer never
# starts there (game.toml selects the software renderer); it still has to
# compile and link, because the rest of the runtime calls into it. SDL's own
# SDL_opengl.h declares nothing on iOS: use a copy without that guard, and
# link the direct calls against OpenGLES (ios_host.mm defines the one it
# lacks).
set(_herc_sdl_gl "${sdl3_SOURCE_DIR}/include/SDL3/SDL_opengl.h")
if(NOT EXISTS "${_herc_sdl_gl}")
    message(FATAL_ERROR "iOS: SDL_opengl.h not found at ${_herc_sdl_gl}")
endif()
file(READ "${_herc_sdl_gl}" _herc_gl_text)
string(REPLACE "#ifndef SDL_PLATFORM_IOS  /* No OpenGL on iOS. */"
               "#if 1  /* hercules ios.cmake: declarations only, never called */"
               _herc_gl_text "${_herc_gl_text}")
file(WRITE "${CMAKE_BINARY_DIR}/ios_gl/SDL3/SDL_opengl.h" "${_herc_gl_text}")
configure_file("${sdl3_SOURCE_DIR}/include/SDL3/SDL_opengl_glext.h"
               "${CMAKE_BINARY_DIR}/ios_gl/SDL3/SDL_opengl_glext.h" COPYONLY)
target_include_directories(psx-runtime BEFORE PRIVATE "${CMAKE_BINARY_DIR}/ios_gl")

target_compile_definitions(psx-runtime PRIVATE HERC_IOS=1)
set(_herc_ios_sources "${HERC_IOS_DIR}/ios_host.mm" "${HERC_IOS_DIR}/ios_present.mm"
                      "${HERC_IOS_DIR}/ios_launcher.mm" "${HERC_IOS_DIR}/ios_disc.mm"
                      "${HERC_IOS_DIR}/ios_overlay.mm" "${HERC_IOS_DIR}/ios_touch.mm"
                      "${HERC_IOS_DIR}/ios_metal_renderer.mm")
target_sources(psx-runtime PRIVATE ${_herc_ios_sources} "${HERC_IOS_DIR}/third_party/miniz/miniz.c")
target_include_directories(psx-runtime PRIVATE "${HERC_IOS_DIR}" "${HERC_IOS_DIR}/third_party/miniz"
                                               "${PSXRECOMP_ROOT}/runtime/src"
                                               "${CMAKE_BINARY_DIR}/ios")
set_source_files_properties("${HERC_IOS_DIR}/third_party/miniz/miniz.c" PROPERTIES COMPILE_OPTIONS "-w")

# The five PAL releases' data-track SHA-1 (each game.toml [prepare_disc]):
# the launcher accepts this build's and names the others.
set(_herc_discs "")
file(GLOB _herc_tomls "${HERC_ROOT}/game.toml" "${HERC_ROOT}/versions/*/game.toml")
foreach(_toml ${_herc_tomls})
    file(READ "${_toml}" _t)
    string(REGEX MATCH "\nid = \"([A-Z]+-[0-9]+)\"" _m "${_t}")
    set(_id "${CMAKE_MATCH_1}")
    string(REGEX MATCH "known_sha1 = \\[[^]]*\"([0-9a-f]+)\"" _m "${_t}")
    set(_sha "${CMAKE_MATCH_1}")
    if(_id AND _sha)
        string(APPEND _herc_discs "    {\"${_id}\", \"${_sha}\"},\n")
    endif()
endforeach()
file(WRITE "${CMAKE_BINARY_DIR}/ios/ios_discs.h"
    "// Generated by ios.cmake from the game.toml files.\n#pragma once\n"
    "#define HERC_BUILD_DISC_ID \"${HERCULES_VERSION}\"\n"
    "static const struct { const char *id; const char *sha1; } kHercDiscs[] = {\n${_herc_discs}};\n")
set_source_files_properties(${_herc_ios_sources} PROPERTIES COMPILE_OPTIONS "-fobjc-arc")
target_link_libraries(psx-runtime PRIVATE
    "-framework UIKit" "-framework Foundation" "-framework GameController"
    "-framework Metal" "-framework QuartzCore"
    "-framework OpenGLES" "-framework AVFoundation" "-framework CoreHaptics"
    "-framework UniformTypeIdentifiers")

# MetalFX exists on devices only (the Simulator SDK has no MetalFX.framework).
if(NOT CMAKE_OSX_SYSROOT MATCHES "[Ss]imulator")
    target_link_libraries(psx-runtime PRIVATE "-framework MetalFX")
    target_compile_definitions(psx-runtime PRIVATE HERC_HAVE_METALFX=1)
endif()

# ---- bundle -------------------------------------------------------------
execute_process(COMMAND git rev-list --count HEAD WORKING_DIRECTORY "${HERC_ROOT}"
                OUTPUT_VARIABLE HERC_IOS_APP_BUILD OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET)
if(NOT HERC_IOS_APP_BUILD)
    set(HERC_IOS_APP_BUILD "1")
endif()
get_target_property(HERC_IOS_EXE psx-runtime OUTPUT_NAME)
configure_file("${HERC_IOS_DIR}/Info.plist.in" "${CMAKE_BINARY_DIR}/ios/Info.plist" @ONLY)
set_target_properties(psx-runtime PROPERTIES
    MACOSX_BUNDLE ON
    MACOSX_BUNDLE_INFO_PLIST "${CMAKE_BINARY_DIR}/ios/Info.plist"
    XCODE_ATTRIBUTE_PRODUCT_BUNDLE_IDENTIFIER "${HERC_IOS_BUNDLE_ID}"
    XCODE_ATTRIBUTE_TARGETED_DEVICE_FAMILY "1,2")

# game.toml for iOS: the software renderer at the PS1's own resolution (the
# presenter upscales it), until the Metal renderer exists.
file(READ "${HERC_GAME_DIR}/game.toml" _herc_toml)
string(REGEX REPLACE "renderer = \"[a-z]+\"" "renderer = \"software\"" _herc_toml "${_herc_toml}")
string(REGEX REPLACE "internal_resolution = \"[a-z0-9]+\"" "internal_resolution = \"native\"" _herc_toml "${_herc_toml}")
file(WRITE "${CMAKE_BINARY_DIR}/ios/game.toml" "${_herc_toml}")
add_custom_command(TARGET psx-runtime POST_BUILD
    COMMAND ${CMAKE_COMMAND} -E copy "${CMAKE_BINARY_DIR}/ios/game.toml"
            "$<TARGET_FILE_DIR:psx-runtime>/game.toml"
    COMMENT "Staging the iOS game.toml (software renderer)"
    VERBATIM)

# The launcher's cover art (ios_launcher.mm), when there is one; the app icon is made from it too (the cover's
# centre, square), in the sizes Info.plist names, as the NFSMW port's icon from its cover.
if(EXISTS "${HERC_IOS_DIR}/LauncherArt.png")
    # Cropped once, then each size scaled from it: sips crops after it scales when given both at once.
    set(_herc_icon_src "${CMAKE_BINARY_DIR}/ios/icons/source.png")
    add_custom_command(OUTPUT "${_herc_icon_src}"
        COMMAND ${CMAKE_COMMAND} -E make_directory "${CMAKE_BINARY_DIR}/ios/icons"
        COMMAND sips -s format png --cropToHeightWidth 780 780 --cropOffset 10 200
                "${HERC_IOS_DIR}/LauncherArt.png" --out "${_herc_icon_src}"
        DEPENDS "${HERC_IOS_DIR}/LauncherArt.png"
        VERBATIM)
    set(_herc_icons "")
    foreach(_icon "Icon-60@2x:120" "Icon-60@3x:180" "Icon-76@2x:152" "Icon-83.5@2x:167" "Icon-40@2x:80"
                  "Icon-40@3x:120" "Icon-29@2x:58" "Icon-29@3x:87")
        string(REPLACE ":" ";" _parts "${_icon}")
        list(GET _parts 0 _name)
        list(GET _parts 1 _px)
        set(_out "${CMAKE_BINARY_DIR}/ios/icons/${_name}.png")
        add_custom_command(OUTPUT "${_out}"
            COMMAND sips -s format png -z ${_px} ${_px} "${_herc_icon_src}" --out "${_out}"
            DEPENDS "${_herc_icon_src}"
            VERBATIM)
        list(APPEND _herc_icons "${_out}")
    endforeach()
    add_custom_target(herc-ios-icons DEPENDS ${_herc_icons})
    add_dependencies(psx-runtime herc-ios-icons)
    add_custom_command(TARGET psx-runtime POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different ${_herc_icons} "$<TARGET_FILE_DIR:psx-runtime>/"
        VERBATIM)
    add_custom_command(TARGET psx-runtime POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E copy_if_different "${HERC_IOS_DIR}/LauncherArt.png"
                "$<TARGET_FILE_DIR:psx-runtime>/LauncherArt.png"
        VERBATIM)
endif()

# The owner's IPA: the disc inside the app (game/).
if(HERC_IOS_BUNDLE_DISC)
    file(GLOB _herc_disc_files "${HERC_IOS_BUNDLE_DISC}/*.cue" "${HERC_IOS_BUNDLE_DISC}/*.bin")
    if(NOT _herc_disc_files)
        message(FATAL_ERROR "HERC_IOS_BUNDLE_DISC: no .cue/.bin in ${HERC_IOS_BUNDLE_DISC}")
    endif()
    add_custom_command(TARGET psx-runtime POST_BUILD
        COMMAND ${CMAKE_COMMAND} -E make_directory "$<TARGET_FILE_DIR:psx-runtime>/game"
        COMMAND ${CMAKE_COMMAND} -E copy_if_different ${_herc_disc_files}
                "$<TARGET_FILE_DIR:psx-runtime>/game/"
        COMMENT "Bundling the disc into the app (game/)"
        VERBATIM)
endif()

# Outside Xcode nothing signs the bundle: sign it ad hoc (the Simulator needs
# a signature; a sideloader re-signs it for a device).
if(NOT CMAKE_GENERATOR STREQUAL "Xcode")
    add_custom_command(TARGET psx-runtime POST_BUILD
        COMMAND codesign --force --sign - --timestamp=none
                "$<TARGET_BUNDLE_DIR:psx-runtime>"
        COMMENT "Signing the app ad hoc"
        VERBATIM)
endif()
